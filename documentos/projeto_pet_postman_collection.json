			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{base_url}}/autenticacao/login?usuario=RM1&senha=senha&duracao=60",
							"host": ["{{base_url}}"],
							"path": ["autenticacao", "login"],
							"query": [
								{"key": "usuario", "value": "RM1"},
								{"key": "senha", "value": "senha"},
								{"key": "duracao", "value": "60"}
							]
						},
						"description": "Realiza login e retorna token JWT. Copie o token e cole na variável {{token}}"
					}
				}
			]
		},
